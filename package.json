{
  "name": "engram-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP gateway for Engram: serves `engram mcp` over Streamable HTTP behind GitHub OAuth.",
  "type": "module",
  "license": "MIT",
  "author": "Fran (FullFran)",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:mcp-http": "node scripts/check-mcp-http.mjs",
    "test:bridge": "node scripts/check-bridge.mjs",
    "test": "npm run build && npm run test:unit && npm run test:auth && npm run test:mcp-http && npm run test:bridge"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FullFran/engram-gateway.git"
  }
}
