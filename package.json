{
  "name": "engram-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP gateway for Engram: serves `engram mcp` over Streamable HTTP behind GitHub OAuth.",
  "type": "module",
  "license": "MIT",
  "author": "Fran (FullFran)",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/shared/gateway-migrations', 'dist/shared/gateway-migrations', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "test:unit": "node scripts/check-unit-scratch.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:mcp-http": "node scripts/check-mcp-http.mjs",
    "test:bridge": "node scripts/check-bridge.mjs",
    "test:backup": "node scripts/check-backup.mjs",
    "test:pats": "node scripts/check-pats.mjs",
    "cli": "node dist/cli.js",
    "test": "npm run build && npm run test:unit && npm run test:auth && npm run test:mcp-http && npm run test:bridge && npm run test:backup && npm run test:pats",
    "eval:build": "node eval/build-dataset.mjs",
    "eval:pool": "node eval/pool.mjs",
    "eval:judgments": "node eval/merge-judgments.mjs",
    "eval:run": "node eval/run.mjs",
    "eval:review": "node eval/review-sample.mjs",
    "eval:report": "node eval/report.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FullFran/engram-gateway.git"
  }
}
